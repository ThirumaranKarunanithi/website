<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.magizhchi.dbcommunicator.ui.MainController"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="topbar,topbar-row">
            <padding><Insets top="6" right="20" bottom="6" left="20"/></padding>

            <!-- LEFT: logo + brand text. -->
            <ImageView fx:id="logoImage" fitHeight="90" preserveRatio="true"/>
            <Label fx:id="brandMark" text="✦" styleClass="brand-mark"/>
            <VBox spacing="0" alignment="CENTER_LEFT">
                <Label text="Magizhchi DB Communicator" styleClass="brand-name"/>
                <Label text="(AI Database Assistant)" styleClass="brand-tagline"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- RIGHT: row 1 = SAVED stuff + status + theme + refresh; row 2 = connection fields. -->
            <VBox spacing="3" alignment="CENTER_RIGHT">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="header-actions,saved-row">
                    <Label text="SAVED" styleClass="field-label"/>
                    <ComboBox fx:id="savedProfilesCombo" styleClass="text-input"
                              prefWidth="200" promptText="(no saved connections)"/>
                    <Button fx:id="saveProfileButton" text="💾 Save"
                            onAction="#onSaveProfile" styleClass="ghost-button"/>
                    <Button fx:id="deleteProfileButton" text="Delete"
                            onAction="#onDeleteProfile" styleClass="ghost-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="signedInUserLabel" text="" styleClass="status-meta"/>
                    <Button fx:id="signOutButton" text="Sign out"
                            onAction="#onSignOut" styleClass="ghost-button"
                            visible="false" managed="false">
                        <tooltip><Tooltip text="Sign out of your Magizhchi account"/></tooltip>
                    </Button>
                    <Label fx:id="statusLabel" text="Disconnected"
                           styleClass="status-pill,status-disconnected"/>
                    <Button fx:id="themeToggleButton" text="☀"
                            onAction="#onToggleTheme" styleClass="ghost-button,icon-button">
                        <tooltip><Tooltip text="Toggle light / dark theme"/></tooltip>
                    </Button>
                    <Button fx:id="refreshSchemaButton" text="↻"
                            onAction="#onRefreshSchema" styleClass="ghost-button,icon-button">
                        <tooltip><Tooltip text="Refresh schema"/></tooltip>
                    </Button>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="connection-row">
                    <VBox spacing="1">
                        <Label text="TYPE" styleClass="field-label"/>
                        <ComboBox fx:id="dbTypeCombo" styleClass="text-input" prefWidth="120"/>
                    </VBox>
                    <VBox spacing="1">
                        <Label text="HOST 🔒" styleClass="field-label,locked-label"/>
                        <TextField fx:id="hostField" text="localhost"
                                   styleClass="text-input" prefWidth="140"/>
                    </VBox>
                    <VBox spacing="1">
                        <Label text="PORT" styleClass="field-label"/>
                        <TextField fx:id="portField" text="5432"
                                   styleClass="text-input" prefWidth="70"/>
                    </VBox>
                    <VBox spacing="1">
                        <Label text="DATABASE" styleClass="field-label"/>
                        <HBox spacing="4">
                            <ComboBox fx:id="dbNameCombo" editable="true" value="postgres"
                                      styleClass="text-input" prefWidth="150"
                                      promptText="select or type"/>
                            <Button fx:id="loadDatabasesButton" text="↻"
                                    onAction="#onLoadDatabases" styleClass="ghost-button"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="1">
                        <Label text="USERNAME" styleClass="field-label"/>
                        <TextField fx:id="usernameField" text="postgres"
                                   styleClass="text-input" prefWidth="110"/>
                    </VBox>
                    <VBox spacing="1">
                        <Label text="PASSWORD" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField" promptText="password"
                                       styleClass="text-input" prefWidth="110"/>
                    </VBox>
                    <VBox spacing="1">
                        <Label text=" " styleClass="field-label"/>
                        <Button fx:id="connectButton" text="Connect" prefWidth="90"
                                onAction="#onConnect" styleClass="primary-button"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar" prefWidth="240">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <Label text="TABLES" styleClass="sidebar-heading"/>
            <ListView fx:id="tablesList" styleClass="sidebar-list" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="chat-container">
            <padding><Insets top="14" right="20" bottom="0" left="14"/></padding>
            <SplitPane fx:id="chatSplit" orientation="VERTICAL" dividerPositions="0.65"
                       VBox.vgrow="ALWAYS" styleClass="chat-split">
                <ScrollPane fx:id="chatScroll" fitToWidth="true" styleClass="chat-scroll">
                    <VBox fx:id="messagesBox" spacing="14" styleClass="messages-box">
                        <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    </VBox>
                </ScrollPane>
                <VBox fx:id="resultPane" styleClass="result-pane" minHeight="80">
                    <padding><Insets top="10" right="6" bottom="6" left="6"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="QUERY RESULT" styleClass="pane-heading"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <fx:define>
                            <ToggleGroup fx:id="viewGroup"/>
                        </fx:define>
                        <ToggleButton fx:id="viewTable" text="📋 Table" selected="true"
                                      toggleGroup="$viewGroup" styleClass="view-toggle"/>
                        <ToggleButton fx:id="viewBar" text="📊 Bar"
                                      toggleGroup="$viewGroup" styleClass="view-toggle"/>
                        <ToggleButton fx:id="viewPie" text="🥧 Pie"
                                      toggleGroup="$viewGroup" styleClass="view-toggle"/>
                        <ToggleButton fx:id="viewLine" text="📈 Line"
                                      toggleGroup="$viewGroup" styleClass="view-toggle"/>
                        <Region prefWidth="10"/>
                        <Button text="−" onAction="#onResultShrink" styleClass="ghost-button,icon-button">
                            <tooltip><Tooltip text="Shrink result area"/></tooltip>
                        </Button>
                        <Button text="+" onAction="#onResultGrow" styleClass="ghost-button,icon-button">
                            <tooltip><Tooltip text="Grow result area"/></tooltip>
                        </Button>
                        <Button text="⛶" onAction="#onResultMaximize" styleClass="ghost-button,icon-button">
                            <tooltip><Tooltip text="Maximize / restore result area"/></tooltip>
                        </Button>
                    </HBox>
                    <StackPane fx:id="resultViewport" VBox.vgrow="ALWAYS">
                        <TableView fx:id="resultTable" styleClass="result-table"/>
                    </StackPane>
                    <Label fx:id="resultMetaLabel" text="" styleClass="result-meta"/>
                </VBox>
            </SplitPane>
        </VBox>
    </center>

    <bottom>
        <VBox styleClass="input-area">
            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="mode-toggle-row">
                <padding><Insets top="8" right="20" bottom="0" left="14"/></padding>
                <fx:define>
                    <ToggleGroup fx:id="inputModeGroup"/>
                </fx:define>
                <ToggleButton fx:id="promptModeButton" text="Prompt" selected="true"
                              toggleGroup="$inputModeGroup" styleClass="mode-toggle"/>
                <ToggleButton fx:id="sqlModeButton" text="SQL"
                              toggleGroup="$inputModeGroup" styleClass="mode-toggle"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="modeHintLabel"
                       text="AI will generate SQL from your question"
                       styleClass="mode-hint"/>
                <ImageView fx:id="creditLogoImage" fitHeight="18" preserveRatio="true"/>
                <Hyperlink fx:id="creditLink" text="Created by Magizhchi Software ↗"
                           onAction="#onOpenWebsite" styleClass="credit-link"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER" styleClass="input-row" minHeight="72">
                <padding><Insets top="8" right="20" bottom="14" left="14"/></padding>
                <Button fx:id="attachFileButton" text="📎" onAction="#onAttachFile"
                        styleClass="ghost-button,attach-button" minHeight="48">
                    <tooltip><Tooltip text="Attach a .sql file to execute, or a .backup/.dump file to restore"/></tooltip>
                </Button>
                <TextArea fx:id="inputArea" wrapText="true" prefRowCount="2" minHeight="48"
                          promptText="Ask the database in plain English…  (e.g. show all employees joined after 2022)"
                          HBox.hgrow="ALWAYS" styleClass="chat-input"/>
                <Button fx:id="sendButton" text="Send" onAction="#onSend"
                        styleClass="primary-button,send-button" minHeight="48"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
