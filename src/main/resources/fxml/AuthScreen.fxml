<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.magizhchi.dbcommunicator.ui.AuthScreenController"
           styleClass="root-pane,auth-root">

    <VBox alignment="CENTER" spacing="14" styleClass="auth-card" maxWidth="440" maxHeight="600">
        <padding><Insets top="28" right="36" bottom="28" left="36"/></padding>

        <ImageView fx:id="logoImage" fitHeight="84" preserveRatio="true"/>
        <Label text="Magizhchi DB Communicator" styleClass="auth-title"/>
        <Label fx:id="screenSubtitle" text="Sign in with a one-time email code" styleClass="auth-subtitle"/>

        <Region prefHeight="6"/>

        <VBox spacing="3">
            <Label text="NAME (optional, for new accounts)" styleClass="field-label"/>
            <TextField fx:id="nameInput" promptText="Your name" styleClass="text-input"/>
        </VBox>

        <VBox spacing="3">
            <Label text="EMAIL" styleClass="field-label"/>
            <TextField fx:id="emailInput" promptText="you@example.com" styleClass="text-input"/>
        </VBox>

        <VBox fx:id="otpField" spacing="3" managed="false" visible="false">
            <Label text="ONE-TIME CODE (6 digits)" styleClass="field-label"/>
            <TextField fx:id="otpInput" promptText="123456" styleClass="text-input,otp-input"/>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Hyperlink fx:id="resendLink" text="Resend code" onAction="#onResend" styleClass="credit-link"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink fx:id="changeEmailLink" text="Change email" onAction="#onChangeEmail" styleClass="credit-link"/>
            </HBox>
        </VBox>

        <HBox alignment="CENTER_LEFT">
            <CheckBox fx:id="rememberMe" text="Keep me signed in" selected="true" styleClass="auth-checkbox"/>
        </HBox>

        <Label fx:id="errorLabel" text=" " wrapText="true" styleClass="auth-error" maxWidth="380"/>

        <Button fx:id="primaryButton" text="Send code" onAction="#onPrimary"
                styleClass="primary-button,send-button" maxWidth="Infinity"/>
    </VBox>
</StackPane>
