# ═══════════════════════════════════════════════════════════════
#  Magizhchi Software — Apache config for the React SPA
#  Deployed to public_html on Hostinger.
# ═══════════════════════════════════════════════════════════════

# ── Serve .exe / .msi as real downloads, not as pages ──────────
<IfModule mod_mime.c>
  AddType application/octet-stream .exe
  AddType application/octet-stream .msi
  AddType application/json         .json
</IfModule>

# Force the browser to download installers instead of trying to render them.
<FilesMatch "\.(exe|msi|dmg|deb|rpm|zip)$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment"
    Header set Content-Type "application/octet-stream"
  </IfModule>
</FilesMatch>

# ── SPA routing ────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # NEVER rewrite anything under /downloads/ — these are real files
  # (installers, latest.json). Without this the SPA fallback below
  # swallows them and returns index.html, so clicking Download
  # appears to do nothing.
  RewriteRule ^downloads/ - [L]

  # Never rewrite the standalone setup guide page.
  RewriteRule ^setup\.html$ - [L]

  # If the request maps to a real file or directory, serve it as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → index.html so React Router can handle the route.
  RewriteRule ^ index.html [L]
</IfModule>

# ── Caching ────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets can be cached forever.
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 month"
  # Never cache the update manifest — the desktop app polls it.
  ExpiresByType application/json        "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # index.html must always be revalidated so users get new builds.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # latest.json must never be cached — it drives in-app updates.
  <FilesMatch "latest\.json$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression ────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
