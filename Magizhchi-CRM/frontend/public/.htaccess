# SPA routing for Hostinger (Apache/LiteSpeed): serve index.html for any path
# that isn't a real file, so client-side routes (/company, /member, /login) work
# on direct visit and refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # If the requested file or directory exists, serve it as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Otherwise hand everything to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Never cache index.html (so new deploys load immediately); cache hashed assets long.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
